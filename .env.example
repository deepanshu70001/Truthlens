# Copy to .env; keep secrets out of version control.
APP_NAME=TruthLens
APP_ENV=development
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000
APP_VERSION=0.1.0
SECRET_KEY=
DEV_AUTH_BYPASS=true
AUTH_USERS_JSON={}
ACCESS_TOKEN_TTL_SECONDS=3600
TRUSTED_HOSTS=localhost,127.0.0.1

# Local SQLite is the default and requires no external database.
DATABASE_URL=sqlite+aiosqlite:///./truthlens.db
DATABASE_ECHO=false

# Storage and upload safety limits
STORAGE_PATH=./data
TEMP_UPLOAD_MAX_AGE_SECONDS=86400
MAX_UPLOAD_SIZE_MB=20
MAX_IMAGE_PIXELS=40000000
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,image/bmp,image/tiff

# Models are lazy-loaded. Some weights may need to be downloaded from Hugging Face.
MODEL_CACHE_DIR=./models/cache
MODEL_CONFIG_PATH=./models/configs
DEVICE=auto
HALF_PRECISION=false
# Default detector uses the fine-tuned linear head from models/baselines with
# the matching google/siglip-base-patch16-224 vision encoder.
AUTHENTICITY_BACKEND=finetuned_siglip
AUTHENTICITY_BACKBONE_MODEL=google/siglip-base-patch16-224
AUTHENTICITY_BACKBONE_REVISION=
AUTHENTICITY_CHECKPOINT_PATH=./models/baselines/siglip_frozen_head.pt
# Alternative existing pretrained classifier: AUTHENTICITY_BACKEND=huggingface
AUTHENTICITY_MODEL=prithivMLmods/Deepfake-Real-Class-Siglip2
# Set a Hugging Face commit hash to reproduce an exact detector checkpoint.
AUTHENTICITY_MODEL_REVISION=
# Leave empty unless an independently reviewed calibration artifact exists.
AUTHENTICITY_CALIBRATION_PATH=
VISION_MODEL=models/baselines/yolov8n.pt
VISION_TIMEOUT_SECONDS=30
XAI_TIMEOUT_SECONDS=30
OCR_LANGUAGES=en,hi
OCR_MODEL_DIR=./models/ocr
OCR_TIMEOUT_SECONDS=60
LANGUAGE_DETECTION_TIMEOUT_SECONDS=30
AI_GENERATED_THRESHOLD=0.65
AUTHENTIC_THRESHOLD=0.35
HF_TOKEN=

# Optional outbound integrations. Google Vision receives uploaded images;
# Fact Check Tools receives OCR-derived claim text.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
GOOGLE_APPLICATION_CREDENTIALS=
FACTCHECK_API_KEY=
CLAIMBUSTER_API_KEY=
FACTCHECK_API_TIMEOUT_SECONDS=10
FACTCHECK_MAX_RESPONSE_BYTES=1000000
PROVENANCE_API_TIMEOUT_SECONDS=30
PROVENANCE_RETRY_ATTEMPTS=1
PROVENANCE_MAX_TOTAL_SECONDS=35
C2PA_TRUST_ANCHORS_PATH=
FORENSIC_TIMEOUT_SECONDS=30
FACTCHECK_MAX_CLAIMS=5
FACTCHECK_MAX_RESULTS_PER_CLAIM=5
FACTCHECK_MAX_TOTAL_SECONDS=25
FACTCHECK_RETRY_ATTEMPTS=0

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_ANALYSIS_PER_MINUTE=4
RATE_LIMIT_FACTCHECK_PER_MINUTE=10
RATE_LIMIT_PROVENANCE_PER_MINUTE=4
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_RETRIEVAL_PER_MINUTE=120

# Durable database queue. Run one worker process; the shared lease serializes
# model/GPU use across API and worker replicas. Jobs are at-least-once.
ANALYSIS_QUEUE_MAX_OUTSTANDING=25
ANALYSIS_JOB_MAX_ATTEMPTS=3
ANALYSIS_JOB_LEASE_SECONDS=120
ANALYSIS_JOB_HEARTBEAT_SECONDS=20
ANALYSIS_JOB_POLL_SECONDS=1
ANALYSIS_RETRY_BASE_SECONDS=2
ANALYSIS_RETRY_MAX_SECONDS=30

# Frontend is configured separately through VITE_API_URL in frontend/.env.local.
