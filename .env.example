# ============================================================
# TruthLens — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_NAME=TruthLens
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_VERSION=0.1.0
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET

# --- Database ---
DATABASE_URL=postgresql+asyncpg://truthlens:truthlens@localhost:5432/truthlens
DATABASE_ECHO=false

# --- Redis (optional, for background tasks) ---
REDIS_URL=redis://localhost:6379/0

# --- Storage ---
UPLOAD_DIR=./storage/uploads
ARTIFACT_DIR=./storage/artifacts
MAX_UPLOAD_SIZE_MB=20
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,image/bmp,image/tiff

# --- ML Models ---
MODEL_CACHE_DIR=./models/cache
DEVICE=auto
# Options: auto | cpu | cuda | cuda:0
HALF_PRECISION=false
# Use float16 on GPU (saves VRAM, may reduce accuracy slightly)

# --- Hugging Face ---
HF_HOME=./models/cache
HUGGINGFACE_TOKEN=

# --- Model Selection ---
# Authenticity detection model
AUTHENTICITY_MODEL=prithivMLmods/Deepfake-Real-Class-Siglip2
# Vision-language model for contextual analysis
VLM_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
# Language detection model
LANG_DETECT_MODEL=papluca/xlm-roberta-base-language-detection
# Object detection model
OBJECT_DETECT_MODEL=yolo26s
# Translation model (optional)
TRANSLATION_MODEL=facebook/nllb-200-distilled-600M

# --- External APIs (optional) ---
# Google Reverse Image Search / Vision API
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
# Fact-checking APIs
GOOGLE_FACTCHECK_API_KEY=
CLAIMBUSTER_API_KEY=

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
# Options: json | text

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=30

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
+